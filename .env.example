# Переменные приложения
DEBUG=True  # Также в данном шаблоне добавляет вывод тел сообщений в консоль. На стендах всегда False
LOCAL=True
APP_HOST=0.0.0.0
APP_PORT=8080

# Специфичные для OpenShift переменные
APPLICATION_NAME=copilot-dkkk
PROJECT_NAME=copilot-dkkk

# Логи
LOG_PATH=.
LOG_FILE_NAME=app.log
LOG_ROTATION=10 MB

# Метрики
METRIC_PATH=.
METRIC_FILE_NAME=app-metric.log

# Аудит
AUDIT_LOG_PATH=.
AUDIT_LOG_FILE_NAME=events.log
HOST_IP=127.0.0.1
HOST_UID=63bd6cbe-170b-49bf-a65c-3ce967398ccd

V2_MODEL_TO_USE=GIGACHAT

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b-mlx
OLLAMA_TEMPERATURE=0.000001
OLLAMA_TIMEOUT=60
OLLAMA_NUM_CTX=65536
OLLAMA_NUM_PREDICT=8192
OLLAMA_REASONING=false

# Gigachat
# Auth mode is auto-detected: set GIGACHAT_CREDENTIALS for token auth (cloud), OR
# GIGACHAT_TLS_CERT_FILEPATH + GIGACHAT_KEY_FILEPATH for certificate/mTLS auth (on-prem).
# Setting both, or neither, fails fast at startup.
GIGACHAT_HOST=gigachat-ift.sberdevices.delta.sbrf.ru
GIGACHAT_PORT=443
GIGACHAT_ENDPOINT=v1
GIGACHAT_MODEL_NAME=GigaChat-3-Ultra
GIGACHAT_CREDENTIALS= # for external cloud token auth
GIGACHAT_CA_BUNDLE_FILEPATH=
GIGACHAT_TLS_CERT_FILEPATH=
GIGACHAT_KEY_FILEPATH=
GIGACHAT_VERIFY_SSL_CERTS=False

EMBEDDING_API_URL=https://foundation-models.api.cloud.ru/v1
EMBEDDING_MODEL_NAME=ai-sage/Giga-Embeddings-instruct-3B
EMBEDDING_API_KEY=

ENABLE_PREVIEW_MODEL_CHECK=False
PREVIEW_MODEL_CHECK_PERCENT=0.01
# Memory store selection
STORE_TO_USE=MEMORY


# Platform V Search
PVS_ENABLED=False
PVS_HOST=tslds-gwsrv0005.delta.sbrf.ru
PVS_PORT=19200
PVS_LOGIN=
PVS_PASSWORD=
PVS_INDEX_NAME=
PVS_CA_BUNDLE_FILEPATH=
PVS_TLS_CERT_FILEPATH=
PVS_KEY_FILEPATH=

# Pangolin
PG_HOST=tsldw-gwsrv0002.delta.sbrf.ru
PG_PORT=6544
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_CA_BUNDLE_FILEPATH=
PG_TLS_CERT_FILEPATH=
PG_KEY_FILEPATH=

# IDP GigaSearch
IDP_HOST=sm.apps.dev-terra000003-ids.ocp.delta.sbrf.ru
IDP_PORT=443
IDP_SOURCE_UUID=
IDP_INDEX_ID=
IDP_CA_BUNDLE_FILEPATH=
IDP_TLS_CERT_FILEPATH=
IDP_KEY_FILEPATH=

# LangFuse
LANGFUSE_TRACING_ENABLED=True
LANGFUSE_HOST=host.docker.internal
LANGFUSE_PORT=3000
LANGFUSE_ENDPOINT=
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_CA_BUNDLE_FILEPATH=certs/langfuse-dev/cert.pem
LANGFUSE_TLS_CERT_FILEPATH=certs/langfuse-dev/cert.pem
LANGFUSE_KEY_FILEPATH=certs/langfuse-dev/key.pem

# Agent resilience: retry / StopEvent / loop prevention
AGENT_LLM_RETRY_ATTEMPTS=3
AGENT_LLM_RETRY_WAIT=2
AGENT_MAX_ITERATIONS=10
AGENT_MAX_MESSAGES=30
AGENT_MAX_PROMPT_TOKENS=30000
AGENT_DUP_TOOL_THRESHOLD=3
AGENT_STOP_ON_CRITICAL=True
AGENT_STOP_ON_ERROR=False

# Database
DB_ENABLED=False
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=

# AEF Tracing
AEF_TRACING_ENABLED=False
AEF_TRACING_KAFKA_TOPIC=
AEF_TRACING_KAFKA_HOSTS=
CLUSTER_NAME=
AGENT_ID=
DISTRIB=
NAMESPACE=

