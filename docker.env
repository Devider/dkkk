# Переменные приложения
DEBUG=True  # Также в данном шаблоне добавляет вывод тел сообщений в консоль. На стендах всегда False
LOCAL=True
APP_HOST=0.0.0.0
APP_PORT=8080

# Специфичные для OpenShift переменные
APPLICATION_NAME=copilot-dkkk
PROJECT_NAME=copilot-dkkk

# Логи
LOG_PATH=.
LOG_FILE_NAME=app.log
LOG_ROTATION=10 MB

# Метрики
METRIC_PATH=.
METRIC_FILE_NAME=app-metric.log

# Аудит
AUDIT_LOG_PATH=.
AUDIT_LOG_FILE_NAME=events.log
HOST_IP=127.0.0.1
HOST_UID=63bd6cbe-170b-49bf-a65c-3ce967398ccd

# Gigachat
# Auth mode is auto-detected: set GIGACHAT_CREDENTIALS for token auth (cloud), OR
# GIGACHAT_TLS_CERT_FILEPATH + GIGACHAT_KEY_FILEPATH for certificate/mTLS auth (on-prem).
# Setting both, or neither, fails fast at startup.
GIGACHAT_HOST=api.giga.chat
GIGACHAT_PORT=
GIGACHAT_ENDPOINT=v1
GIGACHAT_MODEL_NAME=GigaChat-3-Ultra
GIGACHAT_CREDENTIALS=
GIGACHAT_CA_BUNDLE_FILEPATH=
GIGACHAT_TLS_CERT_FILEPATH=
GIGACHAT_KEY_FILEPATH=

ENABLE_PREVIEW_MODEL_CHECK=False
PREVIEW_MODEL_CHECK_PERCENT=0.05
# Memory store selection
STORE_TO_USE=MEMORY


# Platform V Search
PVS_ENABLED=False
PVS_HOST=tslds-gwsrv0005.delta.sbrf.ru
PVS_PORT=19200
PVS_LOGIN=
PVS_PASSWORD=
PVS_INDEX_NAME=
PVS_CA_BUNDLE_FILEPATH=
PVS_TLS_CERT_FILEPATH=
PVS_KEY_FILEPATH=

# Pangolin
PG_HOST=tsldw-gwsrv0002.delta.sbrf.ru
PG_PORT=6544
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_CA_BUNDLE_FILEPATH=
PG_TLS_CERT_FILEPATH=
PG_KEY_FILEPATH=

# IDP GigaSearch
IDP_HOST=sm.apps.dev-terra000003-ids.ocp.delta.sbrf.ru
IDP_PORT=443
IDP_SOURCE_UUID=
IDP_INDEX_ID=
IDP_CA_BUNDLE_FILEPATH=
IDP_TLS_CERT_FILEPATH=
IDP_KEY_FILEPATH=

# LangFuse
LANGFUSE_TRACING_ENABLED=False
LANGFUSE_HOST=
LANGFUSE_PORT=
LANGFUSE_ENDPOINT="/langfuse"
LANGFUSE_PUBLIC_KEY="pk-..."
LANGFUSE_SECRET_KEY="sk-..."
LANGFUSE_CA_BUNDLE_FILEPATH=
LANGFUSE_TLS_CERT_FILEPATH=
LANGFUSE_KEY_FILEPATH=

# Agent resilience: retry / StopEvent / loop prevention
AGENT_LLM_RETRY_ATTEMPTS=3
AGENT_LLM_RETRY_WAIT=2
AGENT_MAX_ITERATIONS=10
AGENT_MAX_MESSAGES=30
AGENT_MAX_PROMPT_TOKENS=30000
AGENT_DUP_TOOL_THRESHOLD=3
AGENT_STOP_ON_CRITICAL=True
AGENT_STOP_ON_ERROR=False

# Database
DB_ENABLED=False
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=

# AEF Tracing
AEF_TRACING_ENABLED=False
AEF_TRACING_KAFKA_TOPIC=
AEF_TRACING_KAFKA_HOSTS=
CLUSTER_NAME=
AGENT_ID=
DISTRIB=
NAMESPACE=

